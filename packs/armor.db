{"name":"Motorcycle Armor","type":"armor","_id":"9Ace0WAgdLRCayIg","img":"icons/svg/shield.svg","system":{"description":"Padded protective wear that keeps the user safe from light impact and lacerations. AV does not apply to firearms.","size":3,"armorValue":2,"carryCapacityBonus":0,"equipped":false},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Full Body Tactical Armor","type":"armor","_id":"AVj598EYL19hCh69","img":"icons/svg/shield.svg","system":{"description":"A series of kevlar panels reinforcing cut resistant clothing at key parts of the body. Includes a larger kevlar vest with side panels and groin protection, backed by steel plates nearly half an inch thick. Reduces all Physical Stress taken by 3, to a minimum of 1.","size":5,"armorValue":3,"carryCapacityBonus":0,"equipped":false},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Thermal Resistant Jacket","type":"armor","_id":"E6OdA29mqZ1jQ6bn","img":"icons/svg/shield.svg","system":{"description":"A thick, well-insulated, flame-resistant jacket; bulky and heavy, but exceptionally engineered to withstand extreme heat or cold. Points spent to resist extreme temperatures count as double. You may wear this in addition to another piece of armor.","size":3,"armorValue":1,"carryCapacityBonus":0,"equipped":false},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Powered Exoskeleton","type":"armor","_id":"MKsVw6fENae1q1oV","img":"icons/svg/shield.svg","system":{"description":"Cutting edge technology from Salien-Welf's commercially available stock. With heavily-armored plates, those who wear it become living tanks. Takes 2 batteries, battery life of 6 hours. Reduces all Physical Stress taken by 3, to a minimum of 1. Does not incur a penalty to Carrying Capacity while worn if charged. When worn while not charged, incurs a Carrying Capacity penalty of 4.","size":6,"armorValue":3,"carryCapacityBonus":0,"equipped":false},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Ballistic Vest","type":"armor","_id":"iTM0rHcZLO87IFwj","img":"icons/svg/shield.svg","system":{"description":"A bullet-proof vest made to protect only the vital organs, typically from firearms. Reduces Physical Stress taken to the chest by 1, to a minimum of 1.","size":3,"armorValue":1,"carryCapacityBonus":0,"equipped":false},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Ballistic Vest with Steel Plate","type":"armor","_id":"uV1XTjgUg3wvXboF","img":"icons/svg/shield.svg","system":{"description":"A woven kevlar vest with additional coverage for the kidneys and liver, backed with a quarter-inch steel plate to protect against small arms fire. Reduces Physical Stress taken to the chest by 2, to a minimum of 1.","size":4,"armorValue":2,"carryCapacityBonus":0,"equipped":false},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Ceramic Dragonscale","type":"armor","_id":"yzyLFl3NgO5Zjd2V","img":"icons/svg/shield.svg","system":{"description":"A rare prototype body armor from a now defunct company, capable of resisting the blast from a grenade. Made of ceramic and titanium composite plating, offering superior protection without hindering movement. Can only be used by someone with a Max Strong of 6 or higher. Does not incur restrictions to Agile and Careful.","size":3,"armorValue":3,"carryCapacityBonus":0,"equipped":false},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Cargo Jacket","type":"armor","_id":"zt198DbC4cUQ3jOF","img":"icons/svg/shield.svg","system":{"description":"A field researcher's dream, this jacket has dozens of pockets, pouches, and flaps, allowing you to carry more things. Increases carrying capacity by 1. You may wear another piece of armor in addition to this.","size":2,"armorValue":0,"carryCapacityBonus":1,"equipped":false},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
