{"name":"Stone Snake (Andrias Petracutis)","type":"npc","_id":"5mCSgS4ndo0WEvNS","img":"icons/svg/mystery-man.svg","system":{"initiative":2,"tn":14,"physLimit":{"value":0,"max":25},"menLimit":{"value":0,"max":12},"traits":[{"name":"Natural Armor","description":"Stone-like skin plates absorb up to 2 Physical Stress from all attacks."},{"name":"Squat Stature","description":"If knocked prone, must spend a full Major Action to get up."}],"majorActions":[{"name":"Claw Swipe (Melee)","description":"Attacks 1 target with bone claws and knocks them prone. Claws break off after a successful attack — must use Bone Snap before attacking this way again.","damage":"6","damageType":"physical"},{"name":"Snarejaw (Close)","description":"Leaps 45 feet and attacks 1 target. TN to defend is 10. Critical failure = restrained, must use a Major Action to escape.","damage":"3","damageType":"physical"}],"minorActions":[{"name":"Bone Snap","description":"Deals 5 Physical Stress to itself, snapping a bone and exposing the sharp jagged edge."}],"notes":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781972618716,"modifiedTime":1781972618716,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Empowered Sophy","type":"npc","_id":"6BNQU77jlqTz5G8x","img":"icons/svg/mystery-man.svg","system":{"initiative":3,"tn":8,"physLimit":{"value":0,"max":0},"menLimit":{"value":0,"max":1},"traits":[{"name":"Patron From The Beyond II","description":"Sophy cannot be harmed. Only destroying Cthulhu's power source destroys her."},{"name":"Eldritch Haste","description":"Can take a Major or Minor action in every other Initiative Group."},{"name":"The Beast Within","description":"Operates entirely on instinct, attacking those closest."}],"majorActions":[{"name":"Big Tentacle Attack (Close)","description":"Sweeping strike against everyone in front. Sets up Tentacle Wrap.","damage":"2d8","damageType":"physical"},{"name":"Tentacle Toss (Medium)","description":"Throws an object at target.","damage":"1d6","damageType":"physical"},{"name":"Screech (Medium)","description":"Causes Mental Stress to all who can hear. Can knock opponents prone.","damage":"2d4","damageType":"mental"}],"minorActions":[{"name":"Tentacle Attack (Close)","description":"Slaps target with giant tentacle. Sets up Tentacle Wrap.","damage":"2d4","damageType":"physical"},{"name":"Tentacle Wrap (Close)","description":"Wraps tendril around targets from Big Tentacle Attack. Restrained targets take 1d4 stress per turn and must use a Major Action to escape. Up to 3 targets."}],"notes":"Invulnerable until power source is destroyed."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781972618716,"modifiedTime":1781972618716,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Time Fly (Dosidicus Vorotempicus)","type":"npc","_id":"6gFbANEj2vI014m0","img":"icons/svg/mystery-man.svg","system":{"initiative":3,"tn":7,"physLimit":{"value":0,"max":5},"menLimit":{"value":0,"max":5},"traits":[{"name":"Grandfather Paradox","description":"Can only be harmed by another creature in the same initiative group it is currently in."},{"name":"Quantum Lamprey","description":"Always acts in the initiative group of the creature it is attached to, directly after that creature."},{"name":"Symbiotic Predator","description":"The creature it is attached to cannot make defend rolls against Anima Drain, but has +1 to other defend rolls."}],"majorActions":[{"name":"Anima Drain (Melee)","description":"Deals 1 Physical and 1 Mental Stress. Can latch onto target — target cannot use a Minor Action next turn, time fly gets 2 Minor Actions.","damage":"1","damageType":"physical"},{"name":"Synchronized Swoop (Melee)","description":"Deals 1 Physical or Mental Stress to a creature another time fly is attached to. Target cannot make a defend roll against this.","damage":"1","damageType":"physical"}],"minorActions":[{"name":"Tachyonic Interference","description":"Target's movement speed is halved on its next turn.","damage":"","damageType":"mental"},{"name":"4th Dimensional Blink","description":"Target and time fly immediately teleport to an empty space within 15 feet."},{"name":"Temporal Debilitation","description":"Any Physical Stress the target takes before its next turn is doubled.","damage":"","damageType":"mental"},{"name":"Initiative Shift","description":"Target rolls 1d12 to determine their new initiative group. Supersedes other initiative-affecting abilities."}],"notes":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781972618716,"modifiedTime":1781972618716,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Brainchild Infected Scientist","type":"npc","_id":"AIOJ6EtgocnCFxKv","img":"icons/svg/mystery-man.svg","system":{"initiative":1,"tn":5,"physLimit":{"value":0,"max":5},"menLimit":{"value":0,"max":4},"traits":[{"name":"Brainchild","description":"Infected with a Brainchild parasite."},{"name":"Natural Prey","description":"Instinctive fear of Baffle Birds — will not move closer to a living Baffle Bird."}],"majorActions":[{"name":"Scientific Acumen (Melee)","description":"Sabotages scientific equipment — raises TN to interact by 2, or creates TN:4 check to use it."},{"name":"Punch (Melee)","description":"Attacks 1 target.","damage":"2","damageType":"physical"},{"name":"Infectious Grasp (Melee)","description":"Attempts to restrain a creature. Saving throw against Brainchild infection."}],"minorActions":[],"notes":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781972618716,"modifiedTime":1781972618716,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Brainchild Infected Guard","type":"npc","_id":"CvOWjMyqk3ZQZzTv","img":"icons/svg/mystery-man.svg","system":{"initiative":3,"tn":9,"physLimit":{"value":0,"max":6},"menLimit":{"value":0,"max":6},"traits":[{"name":"Brainchild","description":"Infected with a Brainchild parasite."},{"name":"Natural Prey","description":"Instinctive fear of baffle birds — will not move closer to a living baffle bird it can see."},{"name":"Powered Exoskeleton","description":"Sealed inside an experimental powered exoskeleton with a built-in high-pressure water hose."},{"name":"Armored","description":"TN to inflict Physical Stress is 12. Physical Stress dealt is always reduced by 3."},{"name":"Expandable","description":"If final Stress targets the power-unit on its back, the unit explodes — dousing everything in Melee range in CO2, knocking creatures prone."}],"majorActions":[{"name":"Punch (Melee)","description":"Attacks 1 target.","damage":"3","damageType":"physical"},{"name":"Back-Mounted Water Hose (Medium)","description":"Hits all in a line for 9 Physical Stress. Failure by 2+ = knocked back 10ft. Failure by 4+ = knocked prone.","damage":"9","damageType":"physical"}],"minorActions":[{"name":"Infectious Grasp (Melee)","description":"Attempts to restrain a creature. Saving throw against Brainchild infection."},{"name":"Empowered Leap (Close)","description":"Jumps to a nearby space, including vertically."}],"notes":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781972618716,"modifiedTime":1781972618716,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Para-sight (Gigaeulagisca Gorganum)","type":"npc","_id":"G1URLo4ILtaXw72U","img":"icons/svg/mystery-man.svg","system":{"initiative":2,"tn":11,"physLimit":{"value":0,"max":4},"menLimit":{"value":0,"max":4},"traits":[{"name":"Imperceptible","description":"Cannot be seen with the naked eye. TN is 6 if the player's eyes are closed."}],"majorActions":[{"name":"Bite (Melee)","description":"Snaps fanged jaws at a target.","damage":"2","damageType":"physical"},{"name":"Strangulate (Melee)","description":"If reared up, leaps at a target and wraps around its head. Target takes 3 Physical Stress per turn. Attacks targeting the Para-sight may deal stress to the victim. Will not release until one of them is incapacitated.","damage":"3","damageType":"physical"}],"minorActions":[{"name":"Rear Up","description":"Lifts the forefront of its body, preparing to strike."}],"notes":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781972618716,"modifiedTime":1781972618716,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Simon Greerson","type":"npc","_id":"I3gu1byqxIjIKXrD","img":"icons/svg/mystery-man.svg","system":{"initiative":3,"tn":6,"physLimit":{"value":0,"max":8},"menLimit":{"value":0,"max":8},"traits":[{"name":"Plot-Essential NPC","description":"Simon cannot truly die. Any time he becomes incapacitated, he enters a deep catatonic state."},{"name":"Communicator","description":"If the party can communicate with Simon remotely, he still counts as part of the party in initiative."}],"majorActions":[],"minorActions":[{"name":"Extensive Expertise","description":"Study an enemy or obstacle described to him. TN decreases by 1."}],"notes":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781972618716,"modifiedTime":1781972618716,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Alya Mudamir","type":"npc","_id":"ILYr5vbbg79Wk6bq","img":"icons/svg/mystery-man.svg","system":{"initiative":3,"tn":8,"physLimit":{"value":0,"max":10},"menLimit":{"value":0,"max":5},"traits":[{"name":"Elusive","description":"The TN to socially interact with Alya is 11."}],"majorActions":[{"name":"Pistol (Close)","description":"Attacks a single target twice.","damage":"1d6","damageType":"physical"}],"minorActions":[],"notes":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781972618716,"modifiedTime":1781972618716,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Colonel Primarch Curtis Abraham","type":"npc","_id":"QOBSNxJbAwbW8te1","img":"icons/svg/mystery-man.svg","system":{"initiative":3,"tn":9,"physLimit":{"value":0,"max":10},"menLimit":{"value":0,"max":10},"traits":[{"name":"Stubborn","description":"The TN to socially interact with Abraham is 11."},{"name":"Commander","description":"As a Minor Action, gives an order to a nearby EDGe Trooper who immediately uses a Major Action."}],"majorActions":[{"name":"EDGe Liquid Pistol (Close)","description":"Attacks up to 2 targets.","damage":"3d4","damageType":"physical"}],"minorActions":[],"notes":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781972618716,"modifiedTime":1781972618716,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Deep One (Oneirodidae Sapien)","type":"npc","_id":"UPULfCsXmb6i4qwL","img":"icons/svg/mystery-man.svg","system":{"initiative":2,"tn":8,"physLimit":{"value":0,"max":6},"menLimit":{"value":0,"max":6},"traits":[{"name":"Amphibious","description":"Breathes air and water. +2 to TN while underwater against non-amphibious creatures."},{"name":"Pressure-Hardened Scales","description":"Reduce any Physical Stress not from heat or sound by 6."},{"name":"Muffling Lipoma","description":"Immune to sonic damage while lipoma is intact. A successful targeted attack removes this ability and triggers Sonic Screech."},{"name":"Nonverbal Communication","description":"Communicates through sign language — only needs to see other Deep Ones."},{"name":"Sonic Vulnerability","description":"If lipoma is destroyed, takes double damage from sound-based sources."}],"majorActions":[{"name":"Alarming Call (Close)","description":"All creatures who can hear take 3 Physical or Mental Stress (their choice). Includes the Deep One if its Muffling Lipoma is destroyed.","damage":"3","damageType":"physical"},{"name":"Sonic Screech (Medium)","description":"Targets one creature — it cannot hear anything else and must spend its next turn getting as close to the Deep One as possible.","damage":"","damageType":"mental"},{"name":"Spear (Melee)","description":"Stabs a creature.","damage":"4","damageType":"physical"}],"minorActions":[],"notes":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781972618716,"modifiedTime":1781972618716,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Baffle Bird (Magnstruthio Baffonis)","type":"npc","_id":"URVRj7YJ8Mt2oXl8","img":"icons/svg/mystery-man.svg","system":{"initiative":1,"tn":9,"physLimit":{"value":0,"max":11},"menLimit":{"value":0,"max":4},"traits":[{"name":"Longstrider","description":"Moves twice as fast as the average person, even when carrying heavy weight."},{"name":"Mount","description":"Can be tamed as a steed. Rider doubles speed. Party travel speed doubles but may increase journey TN by up to 2."},{"name":"Pseudo Party Member","description":"A tamed baffle bird observes basic tactics. Will prioritize nearby food sources."},{"name":"Trace Smell","description":"Can sense TRACEs by smell and determine predator or prey status."},{"name":"Pack Animal","description":"Carrying capacity of 7. Cannot be increased by backpacks."}],"majorActions":[{"name":"Peck (Melee)","description":"Attacks target with its beak.","damage":"6","damageType":"physical"},{"name":"Trample (Special)","description":"Dashes 30 feet in a straight line, attacking all targets within. Each target hit is knocked prone and takes 3 Physical Stress.","damage":"3","damageType":"physical"}],"minorActions":[],"notes":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781972618716,"modifiedTime":1781972618716,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"EDGe Troopers (Orpheus Squad)","type":"npc","_id":"X41SOQA2tT5cZzFk","img":"icons/svg/mystery-man.svg","system":{"initiative":3,"tn":8,"physLimit":{"value":0,"max":10},"menLimit":{"value":0,"max":10},"traits":[{"name":"[Zealots] Oath of Silence","description":"Zealot Stevens and Zealot Gold will not respond verbally to social interaction."}],"majorActions":[{"name":"[Commander Warden / Zealot Stevens] EDGe Smart Rifle (Long)","description":"Attacks single target.","damage":"3d6","damageType":"physical"},{"name":"[Theurge] EDGe Shotgun (Medium)","description":"Attacks single target.","damage":"5d4","damageType":"physical"},{"name":"[Zealot Gold] EDGe Lightning Rod Gun (Close)","description":"Electricity arcs to creatures within Melee range of target on a failed defend roll (1d8).","damage":"3d8","damageType":"physical"},{"name":"[All Troopers] EDGe Liquid Pistol (Close)","description":"Attacks single target.","damage":"3d4","damageType":"physical"}],"minorActions":[{"name":"Stimulant","description":"Reduces Physical Stress by 2.","damage":"2","damageType":"physical"}],"notes":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781972618716,"modifiedTime":1781972618716,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Brainchild Parasite (Pediculus Cerebrus)","type":"npc","_id":"Xi6wgkMnHkGLQTo6","img":"icons/svg/mystery-man.svg","system":{"initiative":3,"tn":3,"physLimit":{"value":0,"max":2},"menLimit":{"value":0,"max":11},"traits":[{"name":"Diminutive","description":"Incredibly small; easily passes unnoticed. Even as an adult, can only move ~10 feet per turn."},{"name":"Infection (Larval Form Only)","description":"Player must make a Luck Roll vs TN or become infected. Infected players forget the interaction, lose the ability to spend Tenacious points, and act in the Brainchild's best interest. Each subsequent interaction raises Infection TN by 2."}],"majorActions":[],"minorActions":[],"notes":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781972618716,"modifiedTime":1781972618716,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Dream Eater Tendril (Greater)","type":"npc","_id":"Ygx1cl1oZujQ1M1L","img":"icons/svg/mystery-man.svg","system":{"initiative":1,"tn":9,"physLimit":{"value":0,"max":8},"menLimit":{"value":0,"max":1},"traits":[{"name":"Slippery","description":"Covered in mucus — grapple attempts immediately fail. The tendril can grip and latch onto creatures."}],"majorActions":[{"name":"Ensnare","description":"Grapples a player, dealing 2 Mental Stress. Grapple ends if tendril takes 4+ Physical Stress.","damage":"2","damageType":"mental"}],"minorActions":[{"name":"Squeeze","description":"Squeezes a grappled target.","damage":"3","damageType":"physical"},{"name":"Chuck","description":"Throws a grappled target 20 feet, dealing 2 Physical Stress and knocking them prone."}],"notes":"Mental Limit not applicable."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781972618716,"modifiedTime":1781972618716,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Seeker Trenton Winifred","type":"npc","_id":"ZNpcEEVjVp0fnO3u","img":"icons/svg/mystery-man.svg","system":{"initiative":2,"tn":8,"physLimit":{"value":0,"max":5},"menLimit":{"value":0,"max":6},"traits":[{"name":"Weapon Proficiency","description":"Proficiency 1 in EDGe Weapons and Proficiency 3 in close-quarters weapons."},{"name":"Bedside Manner","description":"When Winifred uses medicine to heal an ally, it is twice as effective."},{"name":"Surgical Strike","description":"On a critical success with close-quarters weapon, add 3 to total stress dealt."}],"majorActions":[{"name":"Soothe (Melee)","description":"Touched ally regains AP equal to half their Maximum for a given Attribute."},{"name":"Fortify 1/day (Melee)","description":"Increase Physical or Mental limit of touched ally by 6. Lasts 24 hours."},{"name":"Heal (Melee)","description":"TN:7 check to reduce severity of a nearby ally's wound. Once per wound."},{"name":"Triage (Melee)","description":"Reduce nearby ally's Physical or Mental Stress. TN = 6 + levels to reduce. Once per ally per day."},{"name":"EDGe Blaster Pistol (Close)","description":"+1 to attack rolls.","damage":"3d4","damageType":"physical"},{"name":"EDGe Blaster Pistol (Melee)","description":"Slashes with hilt. +3 to attack rolls, +3 stress on critical hit.","damage":"1d4","damageType":"physical"}],"minorActions":[{"name":"Stimulant x3","description":"Heals 1d8 Physical Stress.","damage":"1d8","damageType":"physical"}],"notes":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781972618716,"modifiedTime":1781972618716,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Commander Warden Urban Omar","type":"npc","_id":"cxyKl5nYlFPAjeL4","img":"icons/svg/mystery-man.svg","system":{"initiative":3,"tn":8,"physLimit":{"value":0,"max":4},"menLimit":{"value":0,"max":9},"traits":[{"name":"Mental Resilience","description":"Anytime Omar takes Mental Stress he takes half as much instead."},{"name":"Cognitive Dissonance","description":"Any Mental Stress Omar deals is increased by 3."},{"name":"Weapon Proficiency","description":"+1 to any attacks made with EDGe Weaponry."}],"majorActions":[{"name":"Mindbreak II (Extreme)","description":"Omar inflicts Mental Stress on the target. 3 times — after that he takes half the stress dealt.","damage":"2d6+3","damageType":"mental"},{"name":"EDGe Occultist Censer (Melee)","description":"Smoke increases current and max AP for all attributes by 1 for 1 hour. Otherwise functions as Chain & Hook.","damage":"1d6","damageType":"physical"},{"name":"EDGe Quad-Tranq (Close)","description":"Instead of stress, hit creature has its TN lowered by 1d4. If TN reaches 0, incapacitated.","damage":"1d4","damageType":"physical"},{"name":"Ethereal Cloak (Extreme)","description":"For 6 minutes, TRACEs unaware of Omar cannot perceive him or melee-range allies.","damage":"","damageType":"physical"},{"name":"Eldritch Medium 3/day","description":"Gets a sense for the goals or desires of a single living entity."}],"minorActions":[{"name":"Stimulant","description":"Heals 1d8 Physical Stress.","damage":"1d8","damageType":"physical"},{"name":"Flow State","description":"The next roll Omar makes this turn gains +1."},{"name":"Bend Reality","description":"Omar appears anywhere within 60ft."}],"notes":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781972618716,"modifiedTime":1781972618716,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Dream Eater (Somniafictus Informen)","type":"npc","_id":"d8aHAEI9GtFjpQKF","img":"icons/svg/mystery-man.svg","system":{"initiative":2,"tn":16,"physLimit":{"value":0,"max":30},"menLimit":{"value":0,"max":1},"traits":[{"name":"4th Dimensional Awareness","description":"Can hear your players planning at the table. If they coordinate out loud, the Dream Eater will use that knowledge to foil them."},{"name":"Maddening Alacrity","description":"In addition to its own turn, can take a Minor Action during every other Initiative Group."},{"name":"Grotesque Hydra","description":"Whenever the last Tendril is destroyed, immediately generates more — always 1 more than generated last time."}],"majorActions":[{"name":"Tendril Attack","description":"The Dream Eater attacks with each Tendril on the field. Each takes one Major or Minor Action."},{"name":"Profane Growth","description":"Grows a new Tendril within Close Range."}],"minorActions":[{"name":"Command","description":"Makes an attack with a single Tendril."}],"notes":"Mental Limit not applicable — use Phys Limit only."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781972618716,"modifiedTime":1781972618716,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Food Brooder (Aptenodytes Escaproli)","type":"npc","_id":"dhJVlDZnAT3IQhIf","img":"icons/svg/mystery-man.svg","system":{"initiative":3,"tn":9,"physLimit":{"value":0,"max":20},"menLimit":{"value":0,"max":10},"traits":[{"name":"Sexual Cannibal","description":"May create offspring using genetic material from any creature it successfully attacks with its mandibles."},{"name":"Panoramic Vision","description":"Can see in 360 degrees — cannot be surprised."},{"name":"Photosensitive","description":"Exposed to unexpected bright light: closes all eyes, throws itself flat, then flees in the opposite direction."}],"majorActions":[{"name":"Mandibles (Melee)","description":"Attacks 1 target with its mandibles.","damage":"5","damageType":"physical"}],"minorActions":[],"notes":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781972618716,"modifiedTime":1781972618716,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Dream Eater Tendril","type":"npc","_id":"jhbBBiIj9dpdJZku","img":"icons/svg/mystery-man.svg","system":{"initiative":2,"tn":9,"physLimit":{"value":0,"max":7},"menLimit":{"value":0,"max":1},"traits":[{"name":"4th Dimensional Awareness","description":"Hears players planning and uses that knowledge against them."},{"name":"Maddening Alacrity","description":"Can take a Minor Action during every other Initiative Group."},{"name":"Slippery","description":"Covered in mucus — grapple attempts immediately fail. The tendril can grip and latch onto creatures."}],"majorActions":[{"name":"Ensnare","description":"Grapples a player, dealing 1 Mental Stress. Grapple ends if tendril takes 2+ Physical Stress.","damage":"1","damageType":"mental"},{"name":"Gibbering Mouths","description":"Myriad mouths open along the tendril, releasing a psychic wail. 1 Mental Stress to all within Close range.","damage":"1","damageType":"mental"}],"minorActions":[{"name":"Squeeze","description":"Squeezes a grappled target.","damage":"2","damageType":"physical"},{"name":"Bite","description":"Bites a squeezed target — 2 Physical and 2 Mental Stress.","damage":"2","damageType":"physical"}],"notes":"Mental Limit not applicable."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781972618716,"modifiedTime":1781972618716,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Byakhee (Equinapiaris Luxeleritas)","type":"npc","_id":"lNhj4ArGmxmRL0P4","img":"icons/svg/mystery-man.svg","system":{"initiative":1,"tn":6,"physLimit":{"value":0,"max":12},"menLimit":{"value":0,"max":6},"traits":[{"name":"Flying","description":"Can move 3-dimensionally as long as wings remain intact."},{"name":"Opportunistic Predator","description":"Will not attack any creature it cannot easily fly away from."},{"name":"Swarm-Minded","description":"Always acts in the initiative group with the most player characters. Prioritizes already-attacked creatures. Tie = most hurt creature."},{"name":"Flyby Attacker","description":"Refuses to come into Close or Melee range except to attack. Can only be attacked with Medium+ range weapons or on a defend roll. If player exceeds the Byakhee's TN on a defend, they may automatically succeed on an attack instead."}],"majorActions":[{"name":"Skittish Attack (Extreme)","description":"Swoops in, attacks for 3 Physical Stress, returns to sky. Consumes both Major and Minor Action.","damage":"3","damageType":"physical"},{"name":"Skittish Grab (Extreme)","description":"If a target fails defend rolls twice in a row, it becomes vulnerable for one round. The byakhee attempts to carry the creature off — on failure, target is grabbed. Next turn they vanish into the stars unless stopped. Arcs through sound barrier, knocking all within Close range prone."}],"minorActions":[],"notes":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781972618716,"modifiedTime":1781972618716,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Ed and Sophy","type":"npc","_id":"oeM3kGDIeytCnR4U","img":"icons/svg/mystery-man.svg","system":{"initiative":1,"tn":8,"physLimit":{"value":0,"max":16},"menLimit":{"value":0,"max":6},"traits":[{"name":"Brash Tactics","description":"Ed prefers to fight in close quarters, even when unsafe."},{"name":"Eldritch Haste","description":"In addition to his own turn, Ed can take a Major or Minor action in every other Initiative Group."},{"name":"Symbiosis","description":"All Stress to Ed is halved. All Physical Stress to Sophy is doubled. At half Physical limit, both are stunned for one turn."},{"name":"Patron From The Beyond I","description":"Destroying the source of Cthulhu's power destroys both of them."}],"majorActions":[{"name":"Krav Maga (Melee)","description":"Attempts to disarm and attack with target's own weapon (two defend rolls). Then fires EDGe Liquid Pistol as a free action."},{"name":"Tentacle Attack (Close)","description":"Sophy makes a sweeping strike, knocking targets prone.","damage":"1d8","damageType":"physical"}],"minorActions":[{"name":"EDGe Liquid Pistol (Close)","description":"Attacks up to 2 targets.","damage":"3d4","damageType":"physical"},{"name":"Knife (Melee)","description":"Attacks up to 2 targets.","damage":"1d4","damageType":"physical"},{"name":"Symbiotic Relationship","description":"Sophy heals both of them.","damage":"2d4","damageType":"physical"}],"notes":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781972618716,"modifiedTime":1781972618716,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Maya Mudamir","type":"npc","_id":"sEW1BoGts0brnljo","img":"icons/svg/mystery-man.svg","system":{"initiative":2,"tn":7,"physLimit":{"value":0,"max":7},"menLimit":{"value":0,"max":8},"traits":[{"name":"Incisive","description":"The TN to socially interact with Maya is 9."}],"majorActions":[{"name":"Pistol (Close)","description":"Attacks two targets, once each.","damage":"1d6","damageType":"physical"}],"minorActions":[{"name":"Teenage Prodigy","description":"Study an enemy or obstacle. TN decreases by 1 for her and one chosen ally until end of her next turn."}],"notes":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781972618716,"modifiedTime":1781972618716,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Brainchild Infected Individual","type":"npc","_id":"tAYuZKpnd4Xn2MuU","img":"icons/svg/mystery-man.svg","system":{"initiative":1,"tn":5,"physLimit":{"value":0,"max":5},"menLimit":{"value":0,"max":4},"traits":[{"name":"Brainchild","description":"Infected with a Brainchild parasite. See the Brainchild section for more information."}],"majorActions":[{"name":"Punch (Melee)","description":"Attacks 1 target.","damage":"2","damageType":"physical"},{"name":"Body and Face Hugger (Melee)","description":"Attempts to restrain a creature. If successful, that creature must make a saving throw against the Brainchild's infection ability."}],"minorActions":[],"notes":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781972618716,"modifiedTime":1781972618716,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Major Hierarch Aleksy Burhan","type":"npc","_id":"troDagw1AS12EQkh","img":"icons/svg/mystery-man.svg","system":{"initiative":2,"tn":8,"physLimit":{"value":0,"max":11},"menLimit":{"value":0,"max":11},"traits":[{"name":"Ambush Predator","description":"Burhan does 3 additional stress to anything in a lower initiative group than he is."},{"name":"Wild Nature","description":"Proficiency 1 in all long arms, EDGe weapons, and thrown weapons."},{"name":"Animal Handling","description":"When making a roll to calm an animal, Burhan adds 3 to the roll."},{"name":"Weapon Proficiency","description":"+1 to any attacks made with EDGe Weaponry."}],"majorActions":[{"name":"EDGe K.N.A.I.F.E (Melee)","description":"Cannot miss. Deals 2d4 Physical Stress.","damage":"2d4","damageType":"physical"},{"name":"EDGe Shotgun (Medium)","description":"Deals 5d4 Physical Stress. +1 to hit on this roll.","damage":"5d4","damageType":"physical"}],"minorActions":[{"name":"Stimulant","description":"Heals 1d8 Physical Stress.","damage":"1d8","damageType":"physical"}],"notes":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781972618716,"modifiedTime":1781972618716,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Corporal Deacon Emmanuel Corie","type":"npc","_id":"vhB33y6vfMVoJNTU","img":"icons/svg/mystery-man.svg","system":{"initiative":3,"tn":8,"physLimit":{"value":0,"max":3},"menLimit":{"value":0,"max":12},"traits":[{"name":"Anticipate and React","description":"Cunning points spent on a Defend roll count as double."},{"name":"Basic","description":"Cunning points spent on computers or IT count as double."},{"name":"Subtle Cipher","description":"Can communicate perfectly and silently with allies that can perceive them."}],"majorActions":[{"name":"Epiphany 1/day (Extreme)","description":"Reduce TN of an obstacle by 3, or TN of a creature by 2."},{"name":"Quick Study 3/day (Extreme)","description":"Study a creature or obstacle to glean valuable information shareable with others."},{"name":"EDGe Blaster Pistol (Close)","description":"","damage":"3d4","damageType":"physical"},{"name":"EDGe Blaster Pistol (Melee)","description":"Slashes with hilt.","damage":"1d4","damageType":"physical"}],"minorActions":[{"name":"Stimulant x1","description":"Heals 1d8 Physical Stress.","damage":"1d8","damageType":"physical"}],"notes":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781972618716,"modifiedTime":1781972618716,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Sergeant Deacon Aife Fiore","type":"npc","_id":"xJVRyDeCZMyr0dao","img":"icons/svg/mystery-man.svg","system":{"initiative":2,"tn":8,"physLimit":{"value":0,"max":9},"menLimit":{"value":0,"max":5},"traits":[{"name":"Weapon Proficiency","description":"Fiore adds 3 to EDGe weapon rolls and 2 to Small Arm rolls."},{"name":"Instinct","description":"Fiore always chooses which Initiative group she acts in."},{"name":"Weak Point","description":"When Fiore rolls an 11 or 12 on attack, that is a Critical Success regardless of TN."},{"name":"Pinpoint Accuracy","description":"If Fiore's attack roll exceeds target's TN by 3+, deal 3 additional Physical Stress."}],"majorActions":[{"name":"EDGe Lightning Rod (Close)","description":"Deals 3d8 to target then 1d4 more to creatures within Melee range. +3 to attack rolls.","damage":"3d8","damageType":"physical"},{"name":"EDGe Shockwave Gloves (Melee)","description":"8 uses before depleted (then 2d4). +3 to attack rolls.","damage":"4d4","damageType":"physical"},{"name":"EDGe Impact Grenades x3 (Close)","description":"Roll vs TN 7 (+3) to land on target. Deals 3d4 to all in Melee range.","damage":"3d4","damageType":"physical"}],"minorActions":[{"name":"Stimulant x1","description":"Heals 1d8 Physical Stress.","damage":"1d8","damageType":"physical"},{"name":"Squad Tactics 3/Day","description":"Any ally that can hear Fiore may take a Major Action."},{"name":"Focused Discipline","description":"Fiore gains +4 to her next attack roll."},{"name":"Vicious Attack 3/Day","description":"Fiore makes an attack that would normally be a Major Action."}],"notes":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781972618716,"modifiedTime":1781972618716,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Luwam, The Lost Dreamer","type":"npc","_id":"yjnKHP6l3DoKZ2jj","img":"icons/svg/mystery-man.svg","system":{"initiative":2,"tn":8,"physLimit":{"value":0,"max":10},"menLimit":{"value":0,"max":12},"traits":[{"name":"Driver","description":"Can drive any vehicle with ease."},{"name":"Accursed Gift","description":"Whenever an ally within Close range takes Stress, Luwam absorbs it — taking half."},{"name":"Pacifist","description":"Will refuse to pick up a weapon until convinced there is no other option."},{"name":"Strength in Numbers","description":"When an ally within Melee range spends a Strength point, those points count as double."}],"majorActions":[{"name":"Heal Ally (Melee)","description":"Reduces Physical or Mental Stress of one ally in range by 2.","damage":"2","damageType":"physical"}],"minorActions":[],"notes":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781972618716,"modifiedTime":1781972618716,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
