{"name":"EDGe Flame-Douser (ED-79)","type":"weapon","_id":"HmNlrQ2qYXV9EK5c","img":"icons/svg/sword.svg","system":{"description":"A handheld flame-thrower that sprays lime green fire. A creature who takes stress from this weapon takes an additional 1d6 Physical Stress at the end of each of their turns until they extinguish the fire. Connects to a power source worn on your back. After firing 3 times in a row, it must cool down for 1 turn. You cannot wear a backpack while wielding this weapon.","size":6,"stress":"3d6","range":"medium","category":"edge","shots":{"value":0,"max":0},"equipped":false,"modifier":0,"ammoType":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"EDGe Smart Rifle (ED-57a)","type":"weapon","_id":"Igco1TOrJH44eAGK","img":"icons/svg/sword.svg","system":{"description":"Custom crafted from advanced ceramics. Its specialized rounds are stabilized by miniature fins, allowing micro adjustments mid-flight. You ignore any penalties to your roll when firing with this weapon. <em style='color:var(--cd-text-dim)'>Uses Ammunition (Smart Rifle).</em>","size":4,"stress":"3d6","range":"long","category":"edge","shots":{"value":5,"max":5},"equipped":false,"modifier":0,"ammoType":"Ammunition (Smart Rifle)"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Bow","type":"weapon","_id":"NmkBNBvFRHaO9gOm","img":"icons/svg/sword.svg","system":{"description":"Bows have been used as hunting and defensive weapons for centuries. Modern bows are sleek and lightweight. Requires two hands to fire. Unlike firearms, reloading is a Minor Action. <em style='color:var(--cd-text-dim)'>Uses Ammunition (Arrows).</em>","size":3,"stress":"1d8","range":"medium","category":"small-arms","shots":{"value":1,"max":1},"equipped":false,"modifier":0,"ammoType":"Ammunition (Arrows)"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
