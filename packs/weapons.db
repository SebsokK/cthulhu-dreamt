{"name":"Rifle (Carbine)","type":"weapon","_id":"je3hgaYQ8XaE0KMA","img":"icons/svg/sword.svg","system":{"description":"These guns have either automatic fire rates, or fire in short bursts.","size":4,"stress":"2d6","range":"medium","category":"long-arms","shots":{"value":5,"max":5},"equipped":false,"modifier":0,"ammoType":"Ammunition (Long Arms)"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"EDGe Repeating Eldritch Cannon (ED-249)","type":"weapon","_id":"jvmej8pXGo5bN407","img":"icons/svg/sword.svg","system":{"description":"An incredibly large gun resembling a gatling gun that fires superheated liquid shots. Targets struck are superheated and will sometimes explode. Every creature around the target within melee range also receives 1d4 Mental Stress.","size":6,"stress":"4d4","range":"long","category":"edge","shots":{"value":6,"max":6},"equipped":false,"modifier":0,"ammoType":"Ammunition (Long Arms)"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Revolver","type":"weapon","_id":"kLGq8xGCyQkelB1B","img":"icons/svg/sword.svg","system":{"description":"Reliable and the favored gun in the old west, these guns persist to this day due to their durability and stopping power.","size":3,"stress":"2d4","range":"medium","category":"small-arms","shots":{"value":6,"max":6},"equipped":false,"modifier":0,"ammoType":"Ammunition (Small Arms)"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Machine Gun","type":"weapon","_id":"pypCfCHl7r65x1pT","img":"icons/svg/sword.svg","system":{"description":"A large bipod-mounted gun, usually belt-fed. Its extreme rate of fire is good for ventilating small structures and enemies alike. Costs a Minor Action to tear down or set up, and must be set up before firing.","size":6,"stress":"3d6","range":"long","category":"long-arms","shots":{"value":4,"max":4},"equipped":false,"modifier":0,"ammoType":"Ammunition (Long Arms)"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"EDGe Shockwave Gloves (ED-CQB)","type":"weapon","_id":"qEPEcVupbRRSbvR6","img":"icons/svg/sword.svg","system":{"description":"A pair of large, unwieldy armored gloves with internal batteries that allow the user to deliver a devastating shockwave capable of pushing a 1 ton target up to 1d4×10 feet away. Even after the batteries are depleted, the user is still essentially using weighted gloves. Reloaded with SWUBs. <em style='color:var(--cd-text-dim)'>Reloaded with SWUBs instead of standard ammunition.</em>","size":1,"stress":"4d4 (2d4 if empty)","range":"melee","category":"edge","shots":{"value":8,"max":8},"equipped":false,"modifier":0,"ammoType":"SWUB (Salien-Welf Universal Battery)"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"EDGe K.N.A.I.F.E. (ED-K1)","type":"weapon","_id":"rOrVA4UCgju7ISXA","img":"icons/svg/sword.svg","system":{"description":"Kinetic, Neuro-interfacing, Artificial Intelligence Flat Edge: A bio-restricted knife handle that unsheathes its blade on being gripped and activated by the authorized user, increasing its Size to 2. A built-in machine-learning system guides the user's hand to optimal angles. You cannot miss when attacking with this weapon.","size":1,"stress":"2d4","range":"melee","category":"edge","shots":{"value":0,"max":0},"equipped":false,"modifier":0,"ammoType":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Pistol","type":"weapon","_id":"roe9KSrE1Oa37SAM","img":"icons/svg/sword.svg","system":{"description":"Your average over-the-counter pistol. Smaller caliber, but gets the job done.","size":2,"stress":"1d6","range":"close","category":"small-arms","shots":{"value":8,"max":8},"equipped":false,"modifier":0,"ammoType":"Ammunition (Small Arms)"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Machete","type":"weapon","_id":"xMo564JsbkrA16Ic","img":"icons/svg/sword.svg","system":{"description":"A broad, heavy knife, useful for cutting down flora and fauna alike.","size":3,"stress":"1d6","range":"melee","category":"close-quarters","shots":{"value":0,"max":0},"equipped":false,"modifier":0,"ammoType":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Flare Gun","type":"weapon","_id":"y38vt6C8jrcjtaDU","img":"icons/svg/sword.svg","system":{"description":"Meant as a signaling device to be seen for miles, the flare gun can be used as a weapon in a pinch. Its phosphorus rounds burn hot enough to make the burliest of men swear. <em style='color:var(--cd-text-dim)'>Uses Ammunition (Flare).</em>","size":3,"stress":"2d4","range":"medium","category":"small-arms","shots":{"value":1,"max":1},"equipped":false,"modifier":0,"ammoType":"Ammunition (Flare)"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
