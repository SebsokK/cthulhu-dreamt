{"name":"EDGe Quad-Tranq (ED-WLX4)","type":"weapon","_id":"WM4OlFdY4WBx0OOE","img":"icons/svg/sword.svg","system":{"description":"A four-barrelled, breech-loaded handgun launching specialized darts to incapacitate TRACEs without eliminating them. Instead of dealing stress, hit creatures have their TN lowered by the amount rolled. If TN reaches 0, the creature is incapacitated. Not tested on humans.","size":3,"stress":"1d4","range":"close","category":"edge","shots":{"value":4,"max":4},"equipped":false,"modifier":0,"ammoType":"Ammunition (Small Arms)"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"EDGe Occultist Censer (ED-X)","type":"weapon","_id":"X7YXcmA6UvSQ71wm","img":"icons/svg/sword.svg","system":{"description":"A blend of occultism and applied xenobiology. This censer emits smoke that increases current and maximum AP for all attributes by 1 for 1 hour. When effects wear off, users feel a vertigo-like sensation. Continuous exposure has detrimental side effects. Otherwise functions as a Chain & Hook.","size":4,"stress":"1d6","range":"melee","category":"edge","shots":{"value":0,"max":0},"equipped":false,"modifier":0,"ammoType":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"EDGe Impact Grenade (ED-G3)","type":"weapon","_id":"XVsS2LWuPQxN5ayo","img":"icons/svg/sword.svg","system":{"description":"A smooth ceramic orb that, when cracked, releases intense amounts of microwave radiation to cook anything within range. The shell is somewhat fragile and often carried in special storage containers. Will damage everything in melee range of where it landed.","size":2,"stress":"3d4","range":"close","category":"thrown","shots":{"value":1,"max":1},"equipped":false,"modifier":0,"ammoType":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"EDGe Liquid Pistol (ED-09a)","type":"weapon","_id":"Xdhxhr75W7SuR7uz","img":"icons/svg/sword.svg","system":{"description":"A highly advanced semi-automatic pistol that fires liquid pill-like projectiles containing a tantalum-saline solution, capable of denting steel and piercing skin. Favored for its wallop and bladed guard, which can be used as a bladed melee weapon for 1d4 damage. <em style='color:var(--cd-text-dim)'>Uses Ammunition (Small Arms Tantalum).</em>","size":2,"stress":"2d4","range":"close","category":"edge","shots":{"value":12,"max":12},"equipped":false,"modifier":0,"ammoType":"Ammunition (Small Arms Tantalum)"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Pocket Knife","type":"weapon","_id":"Yfhhc93ZoygcwYvR","img":"icons/svg/sword.svg","system":{"description":"A small knife that fits handily into your pocket. Contains a handful of tools, like a lockpick and screwdriver. Any roll to use the pocket knife as a weapon receives a -2 penalty to the roll.","size":1,"stress":"1d4","range":"melee","category":"close-quarters","shots":{"value":0,"max":0},"equipped":false,"modifier":-2,"ammoType":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
