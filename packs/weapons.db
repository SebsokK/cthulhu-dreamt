{"name":"EDGe Acoustic Cannon (ED-AC)","type":"weapon","_id":"Vl5IBQ3hvyLEkIuN","img":"icons/svg/sword.svg","system":{"description":"This massive sonic weapon is powerful enough to temporarily stun some enemies and does not need to be reloaded, but must stay connected to its power source (worn on your back). You cannot wear a backpack while wielding this weapon. On a Critical Success, your target loses a Major or Minor action on their next turn.","size":5,"stress":"3d6","range":"close","category":"edge","shots":{"value":0,"max":0},"equipped":false,"modifier":0,"ammoType":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
