{"name":"Grenade","type":"weapon","_id":"a3ZF946kFQgWbVab","img":"icons/svg/sword.svg","system":{"description":"Small explosives which can be thrown, exploding after a ten-second timer, which begins when the pin is pulled and the lever is released. Will damage everything in melee range of where it landed.","size":2,"stress":"2d6","range":"close","category":"thrown","shots":{"value":1,"max":1},"equipped":false,"modifier":0,"ammoType":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"EDGe Exterminator Shotgun (ED-12G)","type":"weapon","_id":"bg4Xa50o5mU1r9W8","img":"icons/svg/sword.svg","system":{"description":"A semi-automatic shotgun firing .00 Buckshot made of pure tantalum. Surprisingly simple to use, providing +1 to all attack rolls within Close range, and +2 to attacks within Melee range. <em style='color:var(--cd-text-dim)'>Uses Ammunition (Long Arms Tantalum).</em>","size":4,"stress":"5d4","range":"medium","category":"edge","shots":{"value":7,"max":7},"equipped":false,"modifier":1,"ammoType":"Ammunition (Long Arms Tantalum)"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"name":"Submachine Gun","type":"weapon","_id":"cIX5VV81aiSBr4Yx","img":"icons/svg/sword.svg","system":{"description":"A little larger than a pistol, but packs more of a wallop. Puts more rounds between you and the enemy.","size":3,"stress":"3d4","range":"medium","category":"small-arms","shots":{"value":3,"max":3},"equipped":false,"modifier":0,"ammoType":"Ammunition (Small Arms)"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
