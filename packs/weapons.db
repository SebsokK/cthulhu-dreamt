{"name":"EDGe Lightning Rod (ED-121)","type":"weapon","_id":"H3vHX5EXTAJbISDv","img":"icons/svg/sword.svg","system":{"description":"This large rifle fires a massive tendril of electricity which can arc to other targets. On a Critical Success or Critical Failure, this weapon may strike nearby enemies or allies. Reloaded with SWUBs instead of Ammunition. <em style='color:var(--cd-text-dim)'>Reloaded with SWUBs instead of standard ammunition.</em>","size":5,"stress":"3d8","range":"close","category":"edge","shots":{"value":4,"max":4},"equipped":false,"modifier":0,"ammoType":"SWUB (Salien-Welf Universal Battery)"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.360","systemId":"cthulhu-dreamt","systemVersion":"0.1.0","createdTime":1781948833577,"modifiedTime":1781948833577,"lastModifiedBy":"system","compendiumSource":null,"duplicateSource":null,"exportSource":null}}
